// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

enum Enum_Loan_Status {
  REQUESTED
  APPROVED
  REJECTED
  RETURNED
}

enum Enum_Movement_Type {
  INITIAL
  ENTRY
  EXIT
}

model User {
  id           String    @id @default(cuid())
  name         String
  lastName     String?
  email        String    @unique
  passwordHash String
  role         Enum_Role @default(USER)
  enabled      Boolean   @default(true)
  deleted      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  loans               Loan[]
  createdBooks        Book[]             @relation("BookCreator")
  inventoryMovements  InventoryMovement[]

  @@index([role, enabled])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books       Book[]
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String?  @unique
  description String?
  totalCopies Int      @default(1)
  enabled     Boolean  @default(true)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?    @relation("BookCreator", fields: [createdById], references: [id])

  loanItems           LoanItem[]
  inventoryMovements  InventoryMovement[]

  @@index([title])
  @@index([author])
  @@index([categoryId])
  @@index([createdById])
}

model Loan {
  id          String           @id @default(cuid())
  status      Enum_Loan_Status @default(REQUESTED)
  requestedAt DateTime         @default(now())
  approvedAt  DateTime?
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId      String
  user        User             @relation(fields: [userId], references: [id])
  items       LoanItem[]

  @@index([userId, status])
  @@index([status, requestedAt])
}

model LoanItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  returnedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id])

  bookId     String
  book       Book     @relation(fields: [bookId], references: [id])

  inventoryMovements InventoryMovement[]

  @@unique([loanId, bookId])
  @@index([bookId, returnedAt])
}

model InventoryMovement {
  id        String              @id @default(cuid())
  type      Enum_Movement_Type
  quantity  Int
  createdAt DateTime            @default(now())

  bookId    String
  book      Book                @relation(fields: [bookId], references: [id])

  userId    String
  user      User                @relation(fields: [userId], references: [id])

  loanItemId String?
  loanItem   LoanItem?          @relation(fields: [loanItemId], references: [id])

  @@unique([loanItemId, type])
  @@index([bookId, createdAt])
  @@index([userId])
}
